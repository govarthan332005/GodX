rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── Users: read own doc; admin reads all ──
    // users may edit only name/phone/bankDetails on their own doc;
    // role, balance, totals stay locked to admin/system writes
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'bankDetails']));
    }

    // ── Plans: everyone can read; only admin writes ──
    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Payment methods (UPI / bank accounts shown to users for deposits) ──
    match /paymentMethods/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Announcements: everyone reads; only admin writes ──
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── App content: everyone reads; only admin writes ──
    match /appContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Transactions: user reads/creates own (deposit proofs incl. UTR & screenshot);
    //    only admin updates (approve/reject) ──
    match /transactions/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Investments: user reads own; creates own; admin reads all ──
    match /investments/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
